PORT=8081

# If set, used verbatim as the Postgres DSN (overrides the POSTGRES_* pieces below).
# DATABASE_URL=postgres://rainsaver:rainsaver@localhost:5433/rainsaver?sslmode=disable

POSTGRES_USER=rainsaver
POSTGRES_PASSWORD=rainsaver
POSTGRES_DB=rainsaver
POSTGRES_PORT=5433

# Base URL of the go-auth-service instance issuing/validating tokens for
# this service's "rain-saver" audience.
AUTH_SERVICE_BASE_URL=http://localhost:8080

# Browser origins allowed to call the API (comma-separated). Empty disables CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Geocoder for addresses created without latitude/longitude (Nominatim API).
# The public instance requires an identifying User-Agent and <= 1 req/s.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=rain-saver (+https://github.com/Davi-OS/rain-saver)
